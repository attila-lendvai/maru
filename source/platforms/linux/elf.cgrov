// less $(guix build linux-libre-headers)/include/linux/elf.h

prefix elf/

header elf.h

integer PF_R PF_W PF_X

integer ELFCLASS64 ELFDATA2LSB ELFOSABI_NONE

integer ET_EXEC EM_X86_64

integer PT_NULL PT_LOAD PT_DYNAMIC PT_INTERP PT_NOTE PT_SHLIB PT_PHDR PT_TLS PT_LOOS PT_HIOS PT_LOPROC PT_HIPROC
integer ET_NONE ET_REL ET_EXEC ET_DYN ET_CORE ET_LOPROC ET_HIPROC
integer DT_NULL DT_NEEDED DT_PLTRELSZ DT_PLTGOT DT_HASH DT_STRTAB DT_SYMTAB DT_RELA DT_RELASZ DT_RELAENT DT_STRSZ DT_SYMENT DT_INIT DT_FINI DT_SONAME DT_RPATH DT_SYMBOLIC DT_REL DT_RELSZ DT_RELENT DT_PLTREL DT_DEBUG DT_TEXTREL DT_JMPREL DT_ENCODING DT_LOOS DT_HIOS DT_VALRNGLO DT_VALRNGHI DT_ADDRRNGLO DT_GNU_HASH DT_ADDRRNGHI DT_VERSYM DT_RELACOUNT DT_RELCOUNT DT_FLAGS_1 DT_VERDEF DT_VERDEFNUM DT_VERNEED DT_VERNEEDNUM DT_LOPROC DT_HIPROC

sizes Elf64_Ehdr Elf64_Phdr Elf64_Dyn

//
// Section Headers
//
sizes Elf64_Shdr

/* sh_type */
integer SHT_NULL SHT_PROGBITS SHT_SYMTAB SHT_STRTAB SHT_RELA SHT_HASH SHT_DYNAMIC SHT_NOTE SHT_NOBITS SHT_REL SHT_SHLIB SHT_DYNSYM SHT_NUM SHT_LOPROC SHT_HIPROC SHT_LOUSER SHT_HIUSER

/* sh_flags */
integer SHF_WRITE SHF_ALLOC SHF_EXECINSTR SHF_MERGE SHF_STRINGS SHF_INFO_LINK SHF_LINK_ORDER SHF_OS_NONCONFORMING SHF_GROUP SHF_TLS SHF_ORDERED SHF_EXCLUDE SHF_MASKOS SHF_MASKPROC
// SHF_RELA_LIVEPATCH SHF_RO_AFTER_INIT

/* special section indexes */
integer SHN_UNDEF SHN_LORESERVE SHN_LOPROC SHN_HIPROC SHN_ABS SHN_COMMON SHN_HIRESERVE
// SHN_LIVEPATCH

//
// symtab
//
sizes Elf64_Sym
integer STT_NOTYPE STT_OBJECT STT_FUNC STT_SECTION STT_FILE STT_COMMON STT_TLS
integer STB_LOCAL STB_GLOBAL STB_WEAK

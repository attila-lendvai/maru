// find $(guix build glibc | tail -n 2 | head -n 1)/include/ | grep waitflags
// grep -r "P_PID" $(guix build glibc | tail -n 2 | head -n 1)/include/
// less $(guix build linux-libre-headers)/include/linux/sched.h
// less $(guix build linux-libre-headers)/include/asm/unistd_32.h
// less $(guix build --target=aarch64-linux-gnu linux-libre-headers)/include/asm/unistd_64.h
// less $(guix build linux-libre-headers)/include/asm/unistd_64.h

prefix linux/

// default _GNU_SOURCE 1

header	sys/syscall.h sys/wait.h sys/mman.h unistd.h linux/sched.h fcntl.h

integer STDIN_FILENO STDOUT_FILENO STDERR_FILENO

integer	SYS_exit SYS_read SYS_write SYS_openat SYS_close SYS_chdir SYS_lseek SYS_brk SYS_fsync SYS_mprotect SYS_clone SYS_execve SYS_waitid SYS_wait4

integer AT_FDCWD

integer SIGCHLD CLONE_VM CLONE_VFORK WNOHANG WSTOPPED WEXITED WNOWAIT P_ALL P_PID

integer O_RDONLY O_WRONLY O_RDWR O_CREAT SEEK_SET SEEK_CUR SEEK_END

integer PROT_READ PROT_WRITE PROT_EXEC

header asm/errno.h

// less $(guix build linux-libre-headers)/include/asm-generic/errno-base.h
integer EPERM ENOENT ESRCH EINTR EIO ENXIO E2BIG ENOEXEC EBADF ECHILD EAGAIN ENOMEM EACCES EFAULT ENOTBLK EBUSY EEXIST EXDEV ENODEV ENOTDIR EISDIR EINVAL ENFILE EMFILE ENOTTY ETXTBSY EFBIG ENOSPC ESPIPE EROFS EMLINK EPIPE EDOM ERANGE

// less $(guix build linux-libre-headers)/include/asm-generic/errno.h
integer EDEADLK ENAMETOOLONG ENOLCK ENOSYS ENOTEMPTY ELOOP EWOULDBLOCK ENOMSG EIDRM ECHRNG EL2NSYNC EL3HLT EL3RST ELNRNG EUNATCH ENOCSI EL2HLT EBADE EBADR EXFULL ENOANO EBADRQC EBADSLT EDEADLOCK EBFONT ENOSTR ENODATA ETIME ENOSR ENONET ENOPKG EREMOTE ENOLINK EADV ESRMNT ECOMM EPROTO EMULTIHOP EDOTDOT EBADMSG EOVERFLOW ENOTUNIQ EBADFD EREMCHG ELIBACC ELIBBAD ELIBSCN ELIBMAX ELIBEXEC EILSEQ ERESTART ESTRPIPE EUSERS ENOTSOCK EDESTADDRREQ EMSGSIZE EPROTOTYPE ENOPROTOOPT EPROTONOSUPPORT ESOCKTNOSUPPORT EOPNOTSUPP EPFNOSUPPORT EAFNOSUPPORT EADDRINUSE EADDRNOTAVAIL ENETDOWN ENETUNREACH ENETRESET ECONNABORTED ECONNRESET ENOBUFS EISCONN ENOTCONN ESHUTDOWN ETOOMANYREFS ETIMEDOUT ECONNREFUSED EHOSTDOWN EHOSTUNREACH EALREADY EINPROGRESS ESTALE EUCLEAN ENOTNAM ENAVAIL EISNAM EREMOTEIO EDQUOT ENOMEDIUM EMEDIUMTYPE ECANCELED ENOKEY EKEYEXPIRED EKEYREVOKED EKEYREJECTED EOWNERDEAD ENOTRECOVERABLE ERFKILL EHWPOISON

// default _GNU_SOURCE 1

prefix posix/

header	unistd.h signal.h sys/wait.h sys/mman.h errno.h

integer SIGCHLD WNOHANG WSTOPPED WEXITED WNOWAIT

integer STDIN_FILENO STDOUT_FILENO STDERR_FILENO

integer PROT_READ PROT_WRITE PROT_EXEC _SC_PAGESIZE

integer P_ALL P_PID

integer MAP_FAILED MAP_PRIVATE MAP_ANONYMOUS PROT_READ PROT_WRITE PROT_EXEC

sizes	pid_t

// less $(guix build glibc | tail -n 2 | head -n 1)/include/bits/fcntl-linux.h
header	fcntl.h

integer O_ACCMODE O_RDONLY O_WRONLY O_RDWR O_CREAT O_EXCL O_NOCTTY O_TRUNC O_APPEND O_NONBLOCK O_NDELAY O_SYNC O_ASYNC

header	dlfcn.h

integer RTLD_DEFAULT RTLD_NEXT

integer E2BIG EACCES EADDRINUSE EADDRNOTAVAIL EAFNOSUPPORT EAGAIN EALREADY EBADF EBADMSG EBUSY ECANCELED ECHILD ECONNABORTED ECONNREFUSED ECONNRESET EDEADLK EDESTADDRREQ EDOM EDQUOT EEXIST EFAULT EFBIG EHOSTUNREACH EIDRM EILSEQ EINPROGRESS EINTR EINVAL EIO EISCONN EISDIR ELOOP EMFILE EMLINK EMSGSIZE EMULTIHOP ENAMETOOLONG ENETDOWN ENETRESET ENETUNREACH ENFILE ENOBUFS ENODEV ENOENT ENOEXEC ENOLCK ENOLINK ENOMEM ENOMSG ENOPROTOOPT ENOSPC ENOSR ENOSTR ENOSYS ENOTCONN ENOTDIR ENOTEMPTY ENOTRECOVERABLE ENOTSOCK ENOTSUP ENOTTY ENXIO EOPNOTSUPP EOVERFLOW EOWNERDEAD EPERM EPIPE EPROTO EPROTONOSUPPORT EPROTOTYPE ERANGE EROFS ESPIPE ESRCH ESTALE ETIME ETIMEDOUT ETXTBSY EXDEV EWOULDBLOCK

(with-forms
    ((entry ((name value)
             `(define-constant ,name ,value)))
     (entries (name-value-pairs
               `(let ()
                  ,@(map (lambda (name-value)
                           `(entry ,(first name-value) ,(second name-value)))
                         name-value-pairs)))))
  (entries
   (term/RESET		"[0m")
   (term/BOLD		"[1m")
   (term/UNDERLINE	"[4m")
   (term/BLINK		"[5m")
   (term/NEGATIVE	"[7m")
   (term/BOLD-OFF	"[22m")
   (term/UNDERLINE-OFF	"[24m")
   (term/BLINK-OFF	"[25m")
   (term/NEGATIVE-OFF	"[27m")
   (term/FG-BLACK	"[30m")
   (term/FG-RED		"[31m")
   (term/FG-GREEN	"[32m")
   (term/FG-YELLOW	"[33m")
   (term/FG-BLUE	"[34m")
   (term/FG-MAGENTA	"[35m")
   (term/FG-CYAN	"[36m")
   (term/FG-WHITE	"[37m")
   (term/FG-DEFAULT	"[39m")
   (term/BG-BLACK	"[40m")
   (term/BG-RED		"[41m")
   (term/BG-GREEN	"[42m")
   (term/BG-YELLOW	"[43m")
   (term/BG-BLUE	"[44m")
   (term/BG-MAGENTA	"[45m")
   (term/BG-CYAN	"[46m")
   (term/BG-WHITE	"[47m")
   (term/BG-DEFAULT	"[49m")))

;; 64 bit version
(define-function _r_X (R D B I S)
  (cond
    ((_r0P I)	(cond
                  ((_r0P B)	(_r_D R D))
                  ((= _ESP B)	(_r_DBIS R D _ESP _ESP 1))
                  (else		(_r_DB R D B))))
    ((_r0P B)	(_r_0DIS R D I S))
    (else	(_r_DBIS R D B I S))))

(define-function _rXP (R) (>= (bitwise-and R 15) 8))

(define-function _r8P (R) (= (_rS R) 8))

(define-function _r8 (R)
  (if (_r0P R)
      0
    (if (_r8P R)
        (+ 64 (_rN R))
      (ASMFAIL "64-bit register required"))))

(define-function _REX (W R X B)
  ;; TODO test and use this
  ;; (let ((value (+ (if (_rXP R) 4 0)
  ;;                 (if (_rXP X) 2 0)
  ;;                 (if (_rXP B) 1 0))))
  ;;   (unless (= 0 value)
  ;;     (_B (+ 0x40
  ;;            value
  ;;            (bitwise-shift W 3)))))
  (if (= 0 (or W
               (_rXP R)
               (_rXP X)
               (_rXP B)))
      0
    (_B (+ 64
           (bitwise-shift W 3)
           (if (_rXP R) 4 0)
           (if (_rXP X) 2 0)
           (if (_rXP B) 1 0)))))

;;;
;;; instruction formats
;;;

;; Naming Convention:
;;
;; O		 8 bit opcode
;; OO      	16 bit opcode
;; Os		opcode + b10 when imm fits short (imm8)
;; Or		opcode + register
;; sW, sL		try short (imm8), revert to imm16 or imm32
;; X		dispatch on register, displ, base, index, scale and emit appropriate
;; imm		immediate value, usually postfixed with its size in bits
;; w prefix	emit with the 0x66 prefix; i.e. 16 bit operand size

(define-function _d16 () (_B 102))
(define-function _O (OP) (_B OP))
(define-function _Or (OP R) (_B (bitwise-or OP (_reg R))))
(define-function _OO (OP) (let () (_B (bitwise-shift OP -8)) (_B OP)))
(define-function _OOr (OP R) (let () (_B (bitwise-shift OP -8)) (_B (bitwise-or OP (_reg R)))))
(define-function _Os (OP B) (if (and (long? B) (_s1P B)) (_B (bitwise-or OP _b10)) (_B OP)))
(define-function _sW (W) (if (_s1P W) (_B W) (_W W)))
(define-function _sL (L) (if (_s1P L) (_B L) (_L L)))
(define-function _O_W (OP W) (let () (_O OP) (_W W)))
(define-function _O_D1 (OP D) (let () (_O OP) (_D1 D)))
(define-function _O_D4 (OP D) (let () (_O OP) (_D4 D)))
(define-function _OO_D4 (OP D) (let () (_OO OP) (_D4 D)))
(define-function _Os_sW (OP W) (let () (_Os OP W) (_sW W)))
(define-function _Os_sL (OP L) (let () (_Os OP L) (_sL L)))
(define-function _O_W_B (OP W B) (let () (_O OP) (_W W) (_B B)))
(define-function _Or_B (OP R B) (let () (_Or OP R) (_B B)))
(define-function _Or_W (OP R W) (let () (_Or OP R) (_W W)))
(define-function _Or_L (OP R L) (let () (_Or OP R) (_L L)))
(define-function _Or_Q (OP R Q) (let () (_Or OP R) (_Q Q)))
(define-function _O_Mrm (OP MO R M) (let () (_O OP) (_Mrm MO R M)))
(define-function _OO_Mrm (OP MO R M) (let () (_OO OP) (_Mrm MO R M)))
(define-function _O_Mrm_B (OP MO R M B) (let () (_O OP) (_Mrm MO R M) (_B B)))
(define-function _O_Mrm_W (OP MO R M W) (let () (_O OP) (_Mrm MO R M) (_W W)))
(define-function _O_Mrm_L (OP MO R M L) (let () (_O OP) (_Mrm MO R M) (_L L)))
(define-function _OO_Mrm_B (OP MO R M B) (let () (_OO OP) (_Mrm MO R M) (_B B)))
(define-function _Os_Mrm_sW (OP MO R M W) (let () (_Os OP W) (_Mrm MO R M) (_sW W)))
(define-function _Os_Mrm_sL (OP MO R M L) (let () (_Os OP L) (_Mrm MO R M) (_sL L)))
(define-function _O_r_X (OP R MD MB MI MS) (let () (_O OP) (_r_X R MD MB MI MS)))
(define-function _OO_r_X (OP R MD MB MI MS) (let () (_OO OP) (_r_X R MD MB MI MS)))
(define-function _O_r_X_B (OP R MD MB MI MS B) (let () (_O OP) (_r_X R MD MB MI MS) (_B B)))
(define-function _O_r_X_W (OP R MD MB MI MS W) (let () (_O OP) (_r_X R MD MB MI MS) (_W W)))
(define-function _O_r_X_L (OP R MD MB MI MS L) (let () (_O OP) (_r_X R MD MB MI MS) (_L L)))
(define-function _OO_r_X_B (OP R MD MB MI MS B) (let () (_OO OP) (_r_X R MD MB MI MS) (_B B)))
(define-function _Os_r_X_sW (OP R MD MB MI MS W) (let () (_Os OP W) (_r_X R MD MB MI MS) (_sW W)))
(define-function _Os_r_X_sL (OP R MD MB MI MS L) (let () (_Os OP L) (_r_X R MD MB MI MS) (_sL L)))
(define-function _O_X_B (OP MD MB MI MS B) (_O_r_X_B OP 0 MD MB MI MS B))
(define-function _O_X_W (OP MD MB MI MS W) (_O_r_X_W OP 0 MD MB MI MS W))
(define-function _O_X_L (OP MD MB MI MS L) (_O_r_X_L OP 0 MD MB MI MS L))
(define-function _wO (OP) (let () (_d16) (_O OP)))
(define-function _wOr (OP R) (let () (_d16) (_Or OP R)))
(define-function _wOr_W (OP R W) (let () (_d16) (_Or_W OP R W)))
(define-function _wOs_sW (OP W) (let () (_d16) (_Os_sW OP W)))
(define-function _wO_Mrm (OP MO R M) (let () (_d16) (_O_Mrm OP MO R M)))
(define-function _wOO_Mrm (OP MO R M) (let () (_d16) (_OO_Mrm OP MO R M)))
(define-function _wO_Mrm_B (OP MO R M B) (let () (_d16) (_O_Mrm_B OP MO R M B)))
(define-function _wOO_Mrm_B (OP MO R M B) (let () (_d16) (_OO_Mrm_B OP MO R M B)))
(define-function _wO_Mrm_W (OP MO R M W) (let () (_d16) (_O_Mrm_W OP MO R M W)))
(define-function _wOs_Mrm_sW (OP MO R M W) (let () (_d16) (_Os_Mrm_sW OP MO R M W)))
(define-function _wO_X_W (OP MD MB MI MS W) (let () (_d16) (_O_X_W OP MD MB MI MS W)))
(define-function _wO_r_X (OP R MD MB MI MS) (let () (_d16) (_O_r_X OP R MD MB MI MS)))
(define-function _wOO_r_X (OP R MD MB MI MS) (let () (_d16) (_OO_r_X OP R MD MB MI MS)))
(define-function _wO_r_X_B (OP R MD MB MI MS B) (let () (_d16) (_O_r_X_B OP R MD MB MI MS B)))
(define-function _wOO_r_X_B (OP R MD MB MI MS B) (let () (_d16) (_OO_r_X_B OP R MD MB MI MS B)))
(define-function _wO_r_X_W (OP R MD MB MI MS W) (let () (_d16) (_O_r_X_W OP R MD MB MI MS W)))
(define-function _wOs_r_X_sW (OP R MD MB MI MS W) (let () (_d16) (_Os_r_X_sW OP R MD MB MI MS W)))

(define-function _to_r4 (R)
  (+ 0x40 (_rN R)))

(define-function _p67mr (D B I S R INST)
  (unless (or (_r8P B) (_r8P I))
    (_B 0x67))
  (INST D (_to_r4 B) (_to_r4 I) S R))

(define-function _p67rm (R D B I S INST)
  (unless (or (_r8P B) (_r8P I))
    (_B 0x67))
  (INST R D (_to_r4 B) (_to_r4 I) S))

(define-function _p67im (L D B I S INST)
  (unless (or (_r8P B) (_r8P I))
    (_B 0x67))
  (INST L D (_to_r4 B) (_to_r4 I) S))

;; ALU “Group 1” (the most regular class)

(define-form define-alu-instruction (base-name op reg)
  (with-forms ((name ((suffix) `(concat-symbol base-name ',suffix))))
    `(begin
      ;; 8 bit
      (define-function ,(name Brr)	(RS RD)			(_O_Mrm		,op		_b11 (_r1 RS) (_r1 RD)					))
      (define-function ,(name Bmr)	(MD MB MI MS RD)	(_O_r_X		,(+ op 2)	(_r1 RD)		MD MB MI MS			))
      (define-function ,(name Brm)	(RS MD MB MI MS)	(_O_r_X		,op		(_r1 RS)		MD MB MI MS			))
      (define-function ,(name Bir)	(IM RD)			(_O_Mrm_B	0x80		_b11 ,reg (_r1 RD)			(_s1 IM)	))
      (define-function ,(name Bim)	(IM MD MB MI MS)	(_O_r_X_B	0x80		,reg			MD MB MI MS	(_s1 IM)	))

      ;; 16 bit
      (define-function ,(name Wrr)	(RS RD)			(_wO_Mrm	,(+ op 1)	_b11 (_r2 RS) (_r2 RD)					))
      (define-function ,(name Wmr)	(MD MB MI MS RD)	(_wO_r_X	,(+ op 3)	(_r2 RD)		MD MB MI MS			))
      (define-function ,(name Wrm)	(RS MD MB MI MS)	(_wO_r_X        ,(+ op 1)	(_r2 RS)		MD MB MI MS			))
      (define-function ,(name Wir)	(IM RD)			(_wOs_Mrm_sW	0x81		_b11 ,reg (_r2 RD)			(_s2 IM)	))
      (define-function ,(name Wim)	(IM MD MB MI MS)	(_wOs_r_X_sW	0x81		,reg			MD MB MI MS	(_s2 IM)	))

      ;; 32 bit
      (define-function ,(name Lrr)	(RS RD)			(_O_Mrm		,(+ op 1)	_b11 (_r4 RS) (_r4 RD)					))
      (define-function ,(name Lmr)	(MD MB MI MS RD)	(_O_r_X		,(+ op 3)	(_r4 RD)		MD MB MI MS			))
      (define-function ,(name Lrm)	(RS MD MB MI MS)	(_O_r_X		,(+ op 1)	(_r4 RS)		MD MB MI MS			))
      ;; TODO wrap IM in some assert for the range? keep in mind that it may be a label...
      (define-function ,(name Li8r)	(IM RD)			(_O_Mrm_B	0x83		_b11 ,reg (_r4 RD)			IM		))
      (define-function ,(name Li32r)	(IM RD)			(_O_Mrm_L	0x81		_b11 ,reg (_r4 RD)			IM		))
      (define-function ,(name Lir)	(IM RD)			((if (_s1P IM) ,(name Li8r) ,(name Li32r)) IM RD))
      (define-function ,(name Lim)	(IM MD MB MI MS)	(_Os_r_X_sL	0x81		,reg			MD MB MI MS	IM		))

      ;; 64 bit is just REX prefixed 32 bit
      (define-function ,(name Qrr)	(RS RD)			(_REX 1 RS 0 RD)	(,(name Lrr)	(_r8 RS) (_r8 RD)))
      (define-function ,(name Qmr)	(D B I S RD)		(_REX 1 RD I B)		(,(name Lmr)	D (_r8 B) (_r8 I) S (_r8 RD)))
      (define-function ,(name Qrm)	(RS D B I S)		(_REX 1 RS I B)		(,(name Lrm)	(_r8 RS) D (_r8 B) (_r8 I) S))
      (define-function ,(name Qi8r)	(L RD)			(_REX 1 0 0 RD)		(,(name Li8r)	L (_r8 RD)))
      (define-function ,(name Qi32r)	(L RD)			(_REX 1 0 0 RD)		(,(name Li32r)	L (_r8 RD)))
      (define-function ,(name Qir)	(L RD)			(_REX 1 0 0 RD)		(,(name Lir)	L (_r8 RD)))
      (define-function ,(name Qim)	(L D B I S)		(_REX 1 0 I B)		(,(name Lim)	L D (_r8 B) (_r8 I) S))
      )))

(define-alu-instruction ADD 0x00 _b000)
(define-alu-instruction OR  0x08 _b001)
(define-alu-instruction ADC 0x10 _b010)
(define-alu-instruction SBB 0x18 _b011)
(define-alu-instruction AND 0x20 _b100)
(define-alu-instruction SUB 0x28 _b101)
(define-alu-instruction XOR 0x30 _b110)
(define-alu-instruction CMP 0x38 _b111)

(define-function MOVBrr (RS RD)		(_O_Mrm 128 _b11 (_r1 RS) (_r1 RD)))
(define-function MOVBir (IM R)		(_Or_B 176 (_r1 R) (_s1 IM)))
(define-function MOVBmr32 (D B I S RD)	(_O_r_X 138 (_r1 RD) D B I S))
(define-function MOVBrm32 (RS D B I S)	(_O_r_X 136 (_r1 RS) D B I S))
(define-function MOVBim32 (L D B I S)	(_O_X_B 198 D B I S (_s1 L)))
(define-function MOVBmr (D B I S R)	(_p67mr D B I S R MOVBmr32))
(define-function MOVBrm (R D B I S)	(_p67rm R D B I S MOVBrm32))
(define-function MOVBim (L D B I S)	(_p67im L D B I S MOVBim32))

(define-function MOVLrr (RS RD)			(_O_Mrm 0x89 _b11 (_r4 RS) (_r4 RD)))
(define-function MOVLmr (D B I S RD)		(_O_r_X 0x8b (_r4 RD) D B I S))
(define-function MOVLrm (RS D B I S)		(_O_r_X 0x89 (_r4 RS) D B I S))
(define-function MOVLir (L R)			(_Or_L  0xb8 (_r4 R) L))
(define-function MOVLim (L D B I S)		(_O_X_L 0xc7 D B I S L))

;; TODO ? MOVABSQir emits the same as MOVQir
;;(define-function MOVABSQir (I R)	(_REX 1 0 0 R) (MOVLir I (_r8 R)) (_L (bitwise-shift I -32)))
(define-function MOVQrr (S D)		(_REX 1 S 0 D) (MOVLrr (_r8 S) (_r8 D)))
(define-function MOVQmr (D B I S R)	(_REX 1 R I B) (MOVLmr D (_r8 B) (_r8 I) S (_r8 R)))
(define-function MOVQrm (R D B I S)	(_REX 1 R I B) (MOVLrm (_r8 R) D (_r8 B) (_r8 I) S))
